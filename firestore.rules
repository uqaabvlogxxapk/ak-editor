rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.isPro is bool
        && request.resource.data.createdAt is string
        && request.resource.data.keys().hasOnly(['id', 'email', 'displayName', 'isPro', 'createdAt']);
      allow update: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.keys().hasOnly(['id', 'email', 'displayName', 'isPro', 'createdAt']);
      allow delete: if isOwner(userId);

      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == projectId
          && request.resource.data.title is string
          && request.resource.data.aspectRatio is string
          && request.resource.data.resolution is string
          && request.resource.data.fps is int
          && request.resource.data.durationMs is int
          && request.resource.data.clipCount is int
          && request.resource.data.trackCount is int
          && request.resource.data.projectDataJson is string
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string
          && request.resource.data.keys().hasOnly([
            'id', 'userId', 'title', 'aspectRatio', 'resolution',
            'fps', 'durationMs', 'clipCount', 'trackCount',
            'projectDataJson', 'createdAt', 'updatedAt'
          ]);
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == projectId
          && request.resource.data.keys().hasOnly([
            'id', 'userId', 'title', 'aspectRatio', 'resolution',
            'fps', 'durationMs', 'clipCount', 'trackCount',
            'projectDataJson', 'createdAt', 'updatedAt'
          ]);
        allow delete: if isOwner(userId);
      }
    }
  }
}
